# Copy to .env and fill in. Nothing here needs to be real to run RecoverAI locally —
# every external call (LLM, Razorpay) falls back to a deterministic simulation when
# its key is absent, so the full pipeline runs end-to-end offline. Local dev also
# needs no external services by default: leave DATABASE_URL/REDIS_URL/
# CELERY_BROKER_URL unset and you get SQLite + an in-memory WebSocket layer + a
# filesystem-based Celery broker — no Postgres, no Redis, no Docker.

DEBUG=True
# Replace with a real random value — it signs JWTs (SIMPLE_JWT uses it by default)
# as well as Django's sessions/CSRF, and simplejwt warns if it's under 32 bytes.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=dev-secret-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Optional: point at real Postgres/Redis instead of the zero-dependency local
# defaults (e.g. to debug something Postgres-specific, or mirror production). Leave
# all three unset to use SQLite + in-memory Channels + a filesystem Celery broker. ---
# DATABASE_URL=postgres://recoverai:recoverai@localhost:5432/recoverai
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Dashboard login (JWT) ---
# One seeded operator account, not a registration flow — run
# `python manage.py seed_dashboard_user` after setting these to create/update it.
# DASHBOARD_PASSWORD has no default; the seed command refuses to run without one.
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD=

# --- Optional: real LLM diagnosis/decision reasoning ---
# Leave blank to use the built-in rule-based fallback (fully deterministic, no network call).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Optional: real Razorpay test-mode API calls ---
# Leave blank to run the Action layer in simulation mode (writes a realistic fake
# api_response and result, so the audit trail and ticker still work end-to-end).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Guardrail thresholds
GUARDRAIL_MAX_RETRIES=3
GUARDRAIL_CONTACT_COOLDOWN_HOURS=24
GUARDRAIL_RETRY_COOLDOWN_HOURS=48
GUARDRAIL_SPEND_CEILING_INR=50000
GUARDRAIL_CONFIDENCE_FLOOR=0.60
GUARDRAIL_BUSINESS_HOURS_START=9
GUARDRAIL_BUSINESS_HOURS_END=19

# Demo pacing and reproducibility
# REPLAY_STAGGER_SECONDS: seconds between each transaction in a batch replay (default 1.5).
# RECOVERY_OUTCOME_SEED: leave blank for a fresh random outcome each run. Set it to any
# string to make the replay reproducible - the same transactions resolve the same way every
# time, which is what you want when rehearsing a demo.
REPLAY_STAGGER_SECONDS=1.5
RECOVERY_OUTCOME_SEED=
